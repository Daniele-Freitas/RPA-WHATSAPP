{
  "info": {
    "name": "RPA WhatsApp API",
    "description": "Coleção de requisições para testar a API RPA",
    "version": "1.0"
  },
  "request": [
    {
      "name": "Criar Campanha",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/campanhas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "campanhas"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Campanha Teste - Mai 2026\",\n  \"mensagem\": \"{{saudacao}}, {{primeiro_nome}} tudo bem?\",\n  \"contatos\": [\n    {\n      \"nome\": \"Maria Silva\",\n      \"telefone\": \"5511999999999\",\n      \"variaveis\": {\n        \"primeiro_nome\": \"Maria\"\n      }\n    },\n    {\n      \"nome\": \"João Souza\",\n      \"telefone\": \"5511888888888\",\n      \"variaveis\": {\n        \"primeiro_nome\": \"João\"\n      }\n    }\n  ]\n}"
        }
      },
      "response": []
    },
    {
      "name": "Preview CSV",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "arquivo",
              "type": "file",
              "src": "contatos.csv"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/api/campanhas/preview-csv",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "campanhas", "preview-csv"]
        }
      },
      "response": []
    },
    {
      "name": "Importar CSV",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "arquivo",
              "type": "file",
              "src": "contatos.csv"
            },
            {
              "key": "config",
              "type": "text",
              "value": "{\n  \"nome\": \"Campanha CSV\",\n  \"mensagem\": \"{{saudacao}}, {{primeiro_nome}} tudo bem?\",\n  \"colunaTelefone\": \"Telefone\",\n  \"colunaNome\": \"Nome\",\n  \"colunasVariaveis\": {\n    \"primeiro_nome\": \"PrimeiroNome\",\n    \"empreendimento\": \"Projeto\"\n  }\n}"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/api/campanhas/importar-csv",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "campanhas", "importar-csv"]
        }
      },
      "response": []
    }
  ]
}
